# ScamShield AI — backend environment template.
# Copy to backend/.env and adjust. Never commit the real .env file.

SCAMSHIELD_APP_NAME=ScamShield AI
SCAMSHIELD_VERSION=0.1.0
SCAMSHIELD_API_PREFIX=/api

# Comma-separated list of allowed CORS origins (Vite dev server by default).
SCAMSHIELD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to "production" to flip deployment behaviour.
SCAMSHIELD_ENV=development

# Optional LLM provider key used by Phase 2 analysis. Leave empty for now —
# no key is required to start the backend.
SCAMSHIELD_LLM_API_KEY=

SCAMSHIELD_DEBUG=false
